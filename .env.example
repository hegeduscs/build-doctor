# --- LLM (egyiket töltsd ki) -------------------------------------------------
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
LLM_MODEL=gpt-5.4-mini           # a deployment neve
LLM_BASE_MODEL=gpt-5.4-mini      # csak LlamaIndex + Azure esetén: a deployment mögötti modell neve

# OpenAI-kompatibilis végpont (OpenAI, GitHub Models, Ollama, vagy füstteszthez a fake LLM)
# OPENAI_API_KEY=fake
# OPENAI_BASE_URL=http://localhost:9100/v1
# LLM_MODEL=fake-model

# --- Szolgáltatások ----------------------------------------------------------
CI_API_URL=http://localhost:9000
MCP_URL=http://localhost:8000/mcp
WRITE_MODE=dry-run            # dry-run | enabled   (enabled: tényleg létrehoz issue-t / draft PR-t a mock CI-ban)
AUDIT_LOG=audit/audit.jsonl

# --- Agent -------------------------------------------------------------------
AGENT_IMPL=baseline           # baseline | smolagents | llamaindex | langgraph | <saját modul>
SMOL_VERBOSITY=0
PRICE_IN_PER_M=0.75           # USD / 1M input token (gpt-5.4-mini) – az eval költségbecsléséhez
PRICE_OUT_PER_M=4.5
